NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-02
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=

# ── Klauzula RODO (/klauzula-rodo) — see README-klauzula-rodo.md ─────────
# scrypt hash of the office password:   node scripts/klauzula-hash-password.mjs
KLAUZULA_PASSWORD_HASH=
# 32+ random characters (signs the session cookie and signature stamps):
#   node scripts/klauzula-hash-password.mjs --secret
KLAUZULA_SESSION_SECRET=

# Google OAuth2 (one company Google account, scope drive.file):
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Root folders on Google Drive (IDs). Writes go to the TEST folder unless
# KLAUZULA_DRIVE_TARGET=prod is set on purpose.
KLAUZULA_DRIVE_FOLDER_ID_TEST=
KLAUZULA_DRIVE_FOLDER_ID=
KLAUZULA_DRIVE_TARGET=test
